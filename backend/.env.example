# =============================================
# AURAI BACKEND - Environment Variables
# =============================================

# Server
PORT=3000
NODE_ENV=development

# Database (Neon / Supabase / Local)
# Formato: postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require
# Exemplo Local: postgresql://postgres:postgres@localhost:5432/aurai
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@SEU_HOST.sa-east-1.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OpenRouter (AI)
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_VERIFY_TOKEN=xxx

# Mercado Pago (Payments)
MERCADOPAGO_ACCESS_TOKEN=xxx
MERCADOPAGO_PUBLIC_KEY=xxx

# Google Calendar (optional)
GOOGLE_CALENDAR_API_KEY=xxx

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
